{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SWI-MGMT",
  "version": "0.10.20",
  "identifier": "com.swi-mgmt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace=frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SWI-MGMT",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/swi-mgmt-api"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
